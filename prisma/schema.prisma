datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  WORKSPACE_USER
}

enum Status {
  ACTIVE
  PAUSED
  BROKEN
  PENDING
}

enum RedirectSource {
  ADMIN_DESTINATION
  PRESET_CONTROLLED
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  role             Role     @default(WORKSPACE_USER)
  assignedDomainId String?
  assignedDomainExpiresAt DateTime?
  tenantAccessActive Boolean @default(true)
  tenantAccessExpiresAt DateTime?
  discordWebhookUrl String?
  assignedDomain   Domain?  @relation("AssignedDomain", fields: [assignedDomainId], references: [id])
  createdAt        DateTime @default(now())
  links            Link[]
  domains          Domain[]

  @@index([assignedDomainExpiresAt])
  @@index([tenantAccessExpiresAt])
}

model Domain {
  id         String   @id @default(uuid())
  hostString String   @unique
  isGlobal   Boolean  @default(false)
  status     Status   @default(PENDING)
  createdAt  DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  links      Link[]
  linkSlugAliases LinkSlugAlias[]
  assignedUsers User[] @relation("AssignedDomain")
}

model Link {
  id             String     @id @default(uuid())
  slug           String
  destinationUrl String
  indexPagePreset String   @default("minimal")
  redirectSource   RedirectSource @default(ADMIN_DESTINATION)
  status         Status     @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  domainId       String
  domain         Domain     @relation(fields: [domainId], references: [id])
  clicks         ClickLog[]
  activities     PageActivity[]
  slugAliases    LinkSlugAlias[]

  @@unique([domainId, slug])
  @@index([expiresAt])
}

model LinkSlugAlias {
  id        String   @id @default(uuid())
  slug      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  domainId  String
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, slug])
  @@index([linkId])
  @@index([expiresAt])
}

model LinkPagePreset {
  key         String   @id
  name        String
  description String
  folderPath  String
  htmlContent String
  files       LinkPagePresetFile[]
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model LinkPagePresetFile {
  id          String         @id @default(uuid())
  presetKey   String
  preset      LinkPagePreset @relation(fields: [presetKey], references: [key], onDelete: Cascade)
  filePath    String
  contentType String
  content     String
  contentEncoding String        @default("utf8")
  updatedAt   DateTime       @updatedAt
  createdAt   DateTime       @default(now())

  @@unique([presetKey, filePath])
}

model ClickLog {
  id        String   @id @default(uuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  country   String   @default("Unknown")
  city      String   @default("Unknown")
  browser   String   @default("Unknown")
  os        String   @default("Unknown")
  device    String   @default("Unknown")
  referrer  String   @default("Direct")
  ipAddress String   @default("Unknown")
  isBot     Boolean  @default(false)
  botReason String?
  riskScore Int      @default(0)

  @@index([linkId, timestamp])
  @@index([isBot, timestamp])
}

model PageActivity {
  id        String   @id @default(uuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  eventType String
  path      String   @default("/")
  ipAddress String   @default("Unknown")
  country   String   @default("Unknown")
  city      String   @default("Unknown")
  browser   String   @default("Unknown")
  os        String   @default("Unknown")
  device    String   @default("Unknown")
  referrer  String   @default("Direct")
  metadata  Json?
  isBot     Boolean  @default(false)
  botReason String?
  riskScore Int      @default(0)
  timestamp DateTime @default(now())

  @@index([linkId, timestamp])
  @@index([eventType, timestamp])
  @@index([isBot, timestamp])
}
