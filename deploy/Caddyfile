{
    email your-system-admin@yourplatform.com

    on_demand_tls {
        ask http://localhost:3000/api/domains/check-allowed
        interval 2m
        burst 5
    }
}

yourplatform.com {
    encode gzip zstd
    reverse_proxy localhost:3000
}

:443, :80 {
    tls {
        on_demand
    }

    encode gzip zstd

    reverse_proxy localhost:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
