POSTGRES_DB=link_platform
POSTGRES_USER=link_platform
POSTGRES_PASSWORD=replace_with_strong_database_password

DATABASE_URL=postgresql://link_platform:replace_with_strong_database_password@postgres:5432/link_platform?schema=public

NEXTAUTH_SECRET=replace_with_32_plus_character_random_secret
NEXTAUTH_URL=https://yourplatform.com
NEXT_PUBLIC_APP_DOMAIN=yourplatform.com
APP_DOMAIN=yourplatform.com

INTERNAL_API_SECRET=replace_with_strong_internal_api_secret
INTERNAL_APP_ORIGIN=http://app:3000
PUBLIC_SERVER_IP=203.0.113.10
PLATFORM_CNAME_TARGET=yourplatform.com
CADDY_ADMIN_EMAIL=admin@yourplatform.com

SUPER_ADMIN_EMAIL=admin@yourplatform.com
SUPER_ADMIN_PASSWORD=replace_with_initial_super_admin_password
TENANT_EMAIL=tenant@yourplatform.com
TENANT_PASSWORD=replace_with_initial_tenant_password

UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token
